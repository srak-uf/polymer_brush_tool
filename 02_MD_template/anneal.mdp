gen-vel                 = no
gen-seed                = 12345
gen-temp                = 300
comm-mode               = Linear ; None
nstcomm                 = 50
integrator              = md     ; steep | md | md-vv
dt                      = 0.002  ; ps
nsteps                  = 25000000
pbc                     = xy
nwall                   = 2
wall-atomtype           = c3 c3
wall-type               = 10-4
wall-density = 38 38  ; sqrt(2)/sigma^(-3)
wall-r-linpot           = 0.3
wall-ewald-zfac = 3
ewald-geometry          = 3dc

coulombtype             = PME    ; Cut-off | PME | P3M-AD
coulomb-modifier        = None
rcoulomb                = 1.2
vdwtype                 = Cut-off   ; Cut-off | PME | P3M-AD
vdw-modifier            = None
rvdw                    = 1.2
tcoupl                  = v-rescale
nsttcouple              = 10
; https://pubs.acs.org/doi/10.1021/acs.macromol.2c00323
; tc_grps                 = system  
; tau_t                   = 0.05
; ref_t                   = 5
; ;; Simulated annealing
; annealing               = single     ; 
; annealing_npoints       = 4          ; 
; annealing_time          = 0     100  200   300   ;
; annealing_temp          = 300   600  600   300   ; start and end temperatures
tc-grps                 = HMP  MMP  TMP SOL
tau_t                   = 0.1 0.1 0.1 0.1
ref_t                   = 300 300 300 300
;; Simulated annealing
annealing               = single single single single   ; 
annealing_npoints       = 4 4 4 4         ; 
annealing_time          = 0     12500 25000 37500 0     12500   25000   37500 0     12500   25000   37500  0     12500   25000   37500
annealing_temp          = 300   600   600   300   300   600     600     300   300   600     600     300    300   350     350     300
;; 
pcoupl                  = Berendsen
pcoupltype              = semiisotropic         ; isotropic | semiisotropic (x/y vs z) | anisotropic
tau-p                   = 5.0
compressibility         = 0.0 4.5e-5
ref-p                   = 0.0 1.0                ; [bar]
nstpcouple              = 10
refcoord-scaling        = all
constraints             = h-bonds           ; all-bonds | h-bonds
constraint-algorithm    = LINCS
nstxout-compressed      = 10000
nstxout                 = 50000
nstvout                 = 0
nstenergy               = 5000
compressed-x-grps       = 
nstlist                 = 10
ns-type                 = grid
cutoff-scheme           = Verlet
verlet-buffer-tolerance = -1
rlist                   = 1.4
fourierspacing          = 0.12
pme-order               = 6
ewald-rtol              = 1e-8
DispCorr                = no
lincs-order             = 4
lincs-iter              = 1
continuation            = no
define                  = 
print-nose-hoover-chain-variables = yes

nstcalcenergy           = 10
nstlog                  = 1000
